# Salin menjadi .env lalu sesuaikan bila perlu.
# Nilai di bawah adalah default yang sudah dipakai aplikasi.

# --- Backend ---
# NUTRILABEL_OCR_VERSION=PP-OCRv4
# NUTRILABEL_USE_TABLE_STRUCTURE=1
# NUTRILABEL_REMOVE_WATERMARK=0
# HEALTHIER_YOLO_MODEL=models/isipiringku_v2/weights/best.pt

# --- Frontend ---
# API base juga bisa diatur lewat ?api=http://host:8000
# atau localStorage.setItem('healthier:apiBase', 'http://host:8000')
# HEALTHIER_API_BASE=http://127.0.0.1:8000
